{
  "name": "lead-cleaner",
  "productName": "Lead Cleaner",
  "version": "1.1.0",
  "description": "Turns bulky property/skip-trace exports into clean, import-ready contact lists.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --config.directories.output=$HOME/.lead-cleaner-build && npm run collect",
    "dist:mac": "electron-builder --mac --config.directories.output=$HOME/.lead-cleaner-build && npm run collect",
    "dist:win": "electron-builder --win --config.directories.output=$HOME/.lead-cleaner-build && npm run collect",
    "dist:all": "electron-builder --mac --win --config.directories.output=$HOME/.lead-cleaner-build && npm run collect",
    "collect": "node scripts/collect.js"
  },
  "author": "Egen Media",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/osx-sign": "^1.3.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "build": {
    "appId": "com.egenmedia.leadcleaner",
    "productName": "Lead Cleaner",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "!scripts/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "scripts/afterPack.js"
  }
}
